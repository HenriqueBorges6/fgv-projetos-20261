# Copie para scripts/.env e preencha. NÃO commite o .env real.

# Credenciais AWS Lab (de "AWS Details" no Learner Lab) — usadas por boto3 (run/validate)
AWS_ACCESS_KEY_ID=ASIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=...
AWS_REGION=us-east-1

# Senha do admin do RDS (mesma que rds_admin_password no terraform.tfvars)
RDS_ADMIN_PASSWORD=troque_esta_senha_min8chars
